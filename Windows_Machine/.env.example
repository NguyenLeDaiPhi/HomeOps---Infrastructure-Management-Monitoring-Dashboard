# Windows Machine (monitoring server) environment example
LISTENER_IP=0.0.0.0
PORT=5003

WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8000

COMMAND_API_HOST=0.0.0.0
COMMAND_API_PORT=8500

# URL of the Kali command receiver (must be set)
KALI_COMMAND_URL=http://<kali-host>:8501

# Database connection (PostgreSQL)
DATABASE_URL=postgresql://homeops:<password>@postgres:5432/homeops

# Shared API key and JWT secret (replace in production)
HOMEOPS_API_KEY=<replace-me>
JWT_SECRET=<replace-me>
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
